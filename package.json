{
  "name": "bloodora",
  "version": "4.0.0",
  "private": true,
  "type": "module",
  "description": "BloodOra — unified EJS + TypeScript + Express + Turso blood donation and medical shop platform.",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "tsx src/dev.ts",
    "start": "tsx src/dev.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && node scripts/build.mjs",
    "db:init": "tsx src/db-cli.ts init",
    "db:backup": "tsx src/db-cli.ts backup",
    "make-defaults": "node scripts/make-defaults.mjs",
    "test:unit": "node --import tsx --test test/unit/*.test.mjs",
    "test:contract": "node tests/contract.mjs",
    "test:v3": "node tests/v3.mjs",
    "test:ai": "tsx tests/aiSanitize.mts",
    "test:deploy": "tsx tests/deploy.test.mts",
    "test:budget": "tsx tests/budget.test.mts",
    "test:e2e": "tsx tests/production.e2e.mts",
    "test:remote": "tsx tests/remote.test.mts",
    "test:browser": "playwright test",
    "bench:coldstart": "tsx tests/coldstart.bench.mts",
    "test": "npm run test:unit && npm run test:deploy && npm run test:budget && npm run test:e2e && npm run test:remote && npm run test:ai && npm run test:contract && npm run test:v3"
  },
  "dependencies": {
    "@libsql/client": "^0.15.15",
    "@vercel/blob": "^2.4.0",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "ejs": "^3.1.10",
    "express": "^4.22.3",
    "express-session": "^1.18.2",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.1",
    "multer": "^2.5.0",
    "nodemailer": "^10.3.1",
    "resend": "^6.5.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/hind-siliguri": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/noto-serif-bengali": "^5.3.0",
    "@fortawesome/fontawesome-free": "^6.5.2",
    "@playwright/test": "^1.63.0",
    "@sparticuz/chromium": "^153.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/ejs": "^3.1.5",
    "@types/express": "^4.17.25",
    "@types/express-session": "^1.18.2",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.19.1",
    "@types/nodemailer": "^6.4.21",
    "bootstrap": "^5.3.8",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
