<%- include('partials/header') %>
<main id="bo-main" class="container py-5" style="max-width:560px">
  <section class="card border-0 shadow-sm"><div class="card-body p-4 p-md-5">
    <h1 class="h3 mb-2"><i class="fas fa-user-shield text-danger me-2"></i>Accept your admin invitation</h1>
    <p class="text-muted">This single-use link was issued by an administrator. Set a password to activate your account — it expires 7 days after it was sent.</p>
    <form method="POST" action="/accept-invite" class="d-grid gap-3">
      <input type="hidden" name="token" value="<%= token %>">
      <div>
        <label class="form-label" for="invite-name">Your name</label>
        <input class="form-control" id="invite-name" name="name" value="<%= invitee && invitee.name ? invitee.name : '' %>" required maxlength="80" autocomplete="name">
      </div>
      <div class="p-3 rounded-4" style="background:#f8fafc;border:1px solid #e2e8f0;">
        <div class="small text-muted">Signing in as</div>
        <div class="fw-bold"><%= invitee && invitee.email ? invitee.email : '' %></div>
        <div class="small text-muted">Role: <%= invitee && invitee.role ? invitee.role : '' %></div>
      </div>
      <div>
        <label class="form-label" for="invite-password">Choose a password</label>
        <input class="form-control" id="invite-password" name="password" type="password" minlength="8" maxlength="128" autocomplete="new-password" required>
        <div class="form-text">At least 8 characters with a mix recommended. Your account stays inactive until you finish this step.</div>
      </div>
      <button class="btn btn-danger w-100" type="submit"><i class="fas fa-check me-1"></i>Activate my account</button>
    </form>
  </div></section>
</main>
<%- include('partials/footer') %>
