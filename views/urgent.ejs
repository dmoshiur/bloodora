<%
  const _t = (typeof t === 'function') ? t : (k) => k;
%>
<%- include('partials/header') %>
<div class="container mt-4">
  <h2 class="fw-bold mb-4 text-danger"><i class="fas fa-bolt me-2"></i><%= _t('urgent_title') %></h2>
  <% if (urgent_requests && urgent_requests.length){ %>
    <div class="row g-3">
      <% urgent_requests.forEach(r=>{ %>
        <div class="col-md-6">
          <div class="card border-0 shadow-sm" style="border-radius:18px; border-top:4px solid var(--primary);">
            <div class="card-body">
              <div class="d-flex justify-content-between"><span class="badge bg-danger"><%= r.blood_group %></span><span class="badge bg-warning text-dark"><%= _t('st_urgent') %></span></div>
              <h5 class="fw-bold mt-2"><%= r.patient_name %> — <%= r.hospital_name %></h5>
              <div class="small text-muted"><%= [r.location_upazila, r.location_district].filter(Boolean).join(', ') %> • <%= _t('req_needed') %>: <%= new Date(r.needed_by).toLocaleString() %></div>
              <div class="small mt-2"><%= r.hospital_address %></div>
              <a href="/blood-request/<%= r.id %>" class="btn btn-danger btn-sm mt-3 rounded-pill"><%= _t('urgent_view_help') %></a>
            </div>
          </div>
        </div>
      <% }) %>
    </div>
  <% } else { %>
    <div class="card border-0 shadow-sm text-center p-5" style="border-radius:18px;">
      <i class="fas fa-check-circle fa-3x text-success mb-3"></i>
      <h5><%= _t('urgent_none') %></h5>
      <p class="text-muted"><%= _t('urgent_check_all') %></p>
      <div><a href="/blood-requests" class="btn btn-outline-danger btn-sm rounded-pill"><%= _t('nav_requests') %></a></div>
    </div>
  <% } %>

  <div class="card border-0 shadow-sm mt-4" style="border-radius:18px;">
    <div class="card-header bg-white border-0 pt-4 px-4"><h5 class="fw-bold mb-0"><i class="fas fa-headset me-2 text-danger"></i><%= _t('urgent_contact') %></h5></div>
    <div class="card-body px-4">
      <form method="POST" action="/urgent-contact" class="row g-3">
        <div class="col-md-6"><input name="email" class="form-control" placeholder="<%= _t('urgent_email_ph') %>"></div>
        <div class="col-md-6"><input name="subject" class="form-control" placeholder="<%= _t('msg_subject') %>" required></div>
        <div class="col-12"><textarea name="message" class="form-control" rows="3" placeholder="<%= _t('urgent_msg_ph') %>" required></textarea></div>
        <div class="col-12"><button class="btn btn-danger rounded-pill"><i class="fas fa-paper-plane me-1"></i><%= _t('urgent_send_admin') %></button></div>
      </form>
    </div>
  </div>
</div>
<%- include('partials/footer') %>
