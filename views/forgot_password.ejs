<%- include('partials/header', { title }) %>
<main id="bo-main" class="container py-5" style="max-width:560px">
  <section class="card border-0 shadow-sm"><div class="card-body p-4 p-md-5">
    <h1 class="h3 mb-2">Forgot your password?</h1>
    <p class="text-muted">Enter your account email. If it exists, BloodOra will queue a time-limited reset link. The response is the same for every address.</p>
    <form method="POST" action="/forgot-password">
      <label class="form-label" for="forgot-email">Email address</label>
      <input class="form-control mb-3" id="forgot-email" name="email" type="email" autocomplete="email" required autofocus>
      <button class="btn btn-danger w-100" type="submit">Send reset link</button>
    </form>
    <p class="small mt-3 mb-0">SMS is a paid optional channel. If it is unavailable, this email workflow remains available. <a href="/login">Back to login</a></p>
  </div></section>
</main>
<%- include('partials/footer') %>
