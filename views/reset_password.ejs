<%- include('partials/header', { title }) %>
<main id="bo-main" class="container py-5" style="max-width:560px">
  <section class="card border-0 shadow-sm"><div class="card-body p-4 p-md-5">
    <h1 class="h3 mb-2">Choose a new password</h1>
    <p class="text-muted">This link was validated by the server. A successful reset revokes existing account sessions.</p>
    <form method="POST" action="/reset-password">
      <input type="hidden" name="token" value="<%= token %>">
      <div class="mb-3"><label class="form-label" for="reset-password">New password</label><input class="form-control" id="reset-password" name="password" type="password" minlength="8" maxlength="128" autocomplete="new-password" required></div>
      <div class="mb-3"><label class="form-label" for="reset-confirm">Confirm new password</label><input class="form-control" id="reset-confirm" name="confirm" type="password" minlength="8" maxlength="128" autocomplete="new-password" required></div>
      <button class="btn btn-danger w-100" type="submit">Update password</button>
    </form>
  </div></section>
</main>
<%- include('partials/footer') %>
