<%- include('../partials/header') %>
<%
  const _t2 = (typeof t === 'function') ? t : (k) => k;
%>
<div class="container mt-4 mb-5">
  <div class="mb-3">
    <h2 class="fw-bold mb-0"><i class="fas fa-shield-halved text-danger me-2"></i><%= _t2('sec_title') %></h2>
    <small class="text-muted"><%= _t2('dash_security_sub') %></small>
  </div>

  <div class="dash-wrapper gap-4">
    <%- include('_sidebar', { active: active }) %>

    <main class="flex-grow-1" style="min-width:0;">
      <div class="row g-3">
        <div class="col-lg-6">
          <div class="card border-0 shadow-sm" style="border-radius:18px;">
            <div class="card-header bg-white border-0 pt-3"><h6 class="fw-bold mb-0"><i class="fas fa-key me-2 text-danger"></i><%= _t2('sec_change') %></h6></div>
            <div class="card-body">
              <form method="POST" action="/dashboard/security" class="d-grid gap-3">
                <div>
                  <label class="form-label" for="sec-current"><%= _t2('sec_current') %></label>
                  <input id="sec-current" type="password" name="current" class="form-control" required autocomplete="current-password">
                </div>
                <div>
                  <label class="form-label" for="sec-next"><%= _t2('sec_new') %></label>
                  <input id="sec-next" type="password" name="next" class="form-control" required minlength="8" autocomplete="new-password">
                  <div class="form-text"><%= _t2('sec_min8') %></div>
                </div>
                <div>
                  <label class="form-label" for="sec-confirm"><%= _t2('sec_confirm') %></label>
                  <input id="sec-confirm" type="password" name="confirm" class="form-control" required minlength="8" autocomplete="new-password">
                </div>
                <button type="submit" class="btn btn-danger rounded-pill"><i class="fas fa-key me-1"></i><%= _t2('sec_change') %></button>
                <div class="small text-muted"><i class="fas fa-circle-info me-1"></i><%= _t2('sec_sub') %></div>
              </form>
            </div>
          </div>
        </div>
        <div class="col-lg-6">
          <div class="card border-0 shadow-sm" style="border-radius:18px;">
            <div class="card-header bg-white border-0 pt-3"><h6 class="fw-bold mb-0"><i class="fas fa-circle-info me-2 text-danger"></i><%= _t2('sec_login_info') %></h6></div>
            <div class="card-body d-grid gap-2">
              <div class="p-3 rounded-4" style="background:#f0f9ff; border:1px solid #bae6fd;">
                <div class="small text-muted"><%= _t2('prof_session') %></div>
                <div class="fw-bold"><i class="fas fa-shield-halved me-1 text-success"></i><%= _t2('auth_single_session') %></div>
                <div class="small text-muted"><%= _t2('auth_single_session_sub') %></div>
              </div>
              <div class="p-3 rounded-4" style="background:#f8fafc; border:1px solid #e2e8f0;">
                <div class="small text-muted"><%= _t2('common_email') %></div>
                <div class="fw-bold"><%= user.email %></div>
              </div>
              <div class="p-3 rounded-4" style="background:#f8fafc; border:1px solid #e2e8f0;">
                <div class="small text-muted"><%= _t2('prof_last_login_ip') %></div>
                <div class="fw-bold"><%= user.last_login_ip || '—' %></div>
              </div>
              <div class="p-3 rounded-4" style="background:#f8fafc; border:1px solid #e2e8f0;">
                <div class="small text-muted"><%= _t2('common_role') %></div>
                <div class="fw-bold">
                  <% if (user.is_super_admin) { %><span class="badge bg-dark rounded-pill"><%= _t2('account_superadmin') %></span>
                  <% } else if (user.is_admin) { %><span class="badge bg-primary rounded-pill"><%= _t2('nav_admin') %></span>
                  <% } else { %><span class="badge bg-secondary rounded-pill"><%= _t2('account_user') %></span><% } %>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
      <div class="row g-3 mt-1">
        <div class="col-lg-6"><section class="card border-0 shadow-sm h-100" style="border-radius:18px"><div class="card-body">
          <h3 class="h6"><i class="fas fa-envelope-circle-check me-2 text-danger"></i>Email verification</h3>
          <p class="small text-muted"><%= user.email %> · <span class="badge <%= user.email_verified ? 'text-bg-success' : 'text-bg-warning' %>"><%= user.email_verified ? 'Verified' : 'Not verified' %></span></p>
          <% if (!user.email_verified) { %><form method="POST" action="/dashboard/security/email/request"><button class="btn btn-outline-danger btn-sm">Send verification email</button></form><% } %>
          <hr>
          <h3 class="h6"><i class="fas fa-mobile-screen me-2 text-danger"></i>Phone verification</h3>
          <p class="small text-muted"><%= user.phone %> · <span class="badge <%= user.phone_verified ? 'text-bg-success' : 'text-bg-warning' %>"><%= user.phone_verified ? 'Verified' : 'Not verified' %></span></p>
          <% if (!user.phone_verified) { %>
            <form method="POST" action="/dashboard/security/phone/request" class="mb-2"><button class="btn btn-outline-danger btn-sm">Send SMS code</button></form>
            <form method="POST" action="/dashboard/security/phone/verify" class="input-group input-group-sm"><input class="form-control" name="code" inputmode="numeric" pattern="[0-9]{6}" maxlength="6" autocomplete="one-time-code" aria-label="6-digit SMS code" required><button class="btn btn-danger">Verify</button></form>
            <p class="small text-muted mt-2 mb-0">SMS requires configured paid credits. Failures never expose the code; email verification remains available.</p>
          <% } %>
        </div></section></div>
        <div class="col-lg-6"><section class="card border-0 shadow-sm h-100" style="border-radius:18px"><div class="card-body">
          <h3 class="h6"><i class="fas fa-bell me-2 text-danger"></i>Notification preferences</h3>
          <form method="POST" action="/dashboard/security/preferences">
            <div class="form-check mb-2"><input class="form-check-input" id="pref-inapp" type="checkbox" name="notify_inapp" value="1" <%= user.notify_inapp !== false ? 'checked' : '' %>><label class="form-check-label" for="pref-inapp">In-app notifications</label></div>
            <div class="form-check mb-2"><input class="form-check-input" id="pref-email" type="checkbox" name="notify_email" value="1" <%= user.notify_email !== false ? 'checked' : '' %>><label class="form-check-label" for="pref-email">Transactional email notifications</label></div>
            <div class="form-check mb-3"><input class="form-check-input" id="pref-sms" type="checkbox" name="notify_sms" value="1" <%= user.notify_sms ? 'checked' : '' %>><label class="form-check-label" for="pref-sms">Important SMS notifications <span class="text-muted small">(paid credits may be consumed)</span></label></div>
            <button class="btn btn-danger btn-sm">Save preferences</button>
          </form>
        </div></section></div>
      </div>
    </main>
  </div>
</div>
<%- include('../partials/footer') %>
