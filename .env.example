# BloodOra unified application — copy to .env for local development.
# Never commit real credentials. Vercel values belong in Project Settings →
# Environment Variables; local .env files are not uploaded.

# ---- Runtime ----
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
# Canonical public origin and base for email links. Additional comma-separated
# origins are allowed for credentialed API clients. Same-origin SSR/forms work
# without a BACKEND_URL or a second frontend server.
FRONTEND_URL=http://localhost:4000

# ---- Turso / libSQL ----
# Development: leave both empty to use ./data/local.db.
# Production: set libsql://... and its token; both are required.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ---- Authentication and sessions ----
# Generate with: openssl rand -hex 32
JWT_SECRET=
JWT_TTL_DAYS=7
COOKIE_DOMAIN=
# Production always uses Secure cookies. For local HTTPS, set COOKIE_SECURE=1.
COOKIE_SECURE=

# ---- Idempotent first-super-admin provisioning (optional) ----
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_NAME=Super Admin
SUPER_ADMIN_PHONE=

# ---- Uploads / Vercel Blob ----
# Without a token, new development uploads use Turso BLOB storage. Production
# should use Blob. Existing /uploads/:filename aliases work with either backend.
BLOB_READ_WRITE_TOKEN=
MAX_UPLOAD_MB=4
UPLOAD_TIMEOUT_MS=5000

# ---- Transactional email ----
# Resend is primary. SMTP is used when explicitly selected or when Resend fails.
# With neither configured, delivery is skipped honestly; no success is simulated.
RESEND_API_KEY=
RESEND_FROM_NAME=BloodOra
RESEND_FROM_EMAIL=
SMTP_ENABLED=0
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=BloodOra
SMTP_FROM_EMAIL=no-reply@example.com
SMTP_TIMEOUT_MS=2500

# ---- SMS and OTP ----
# Supported provider adapters: disabled, greenweb, sslwireless.
# Paid provider credentials are required for real delivery.
SMS_PROVIDER=disabled
SMS_API_KEY=
SMS_API_SECRET=
SMS_SENDER_ID=
# Optional provider endpoint override; leave empty for the adapter default.
SMS_API_URL=
SMS_TIMEOUT_MS=4000
SMS_COST_PER_MESSAGE=0
SMS_CURRENCY=BDT
# Optional dedicated HMAC pepper; JWT_SECRET is the fallback.
SMS_OTP_PEPPER=

# ---- AI (OpenAI-compatible; Groq by default) ----
# Saved Admin → AI Assistant settings take precedence over these defaults.
GROQ_API_KEY=
AI_PROVIDER=groq
AI_MODEL=qwen/qwen3.6-27b
AI_BASE_URL=https://api.groq.com/openai/v1
AI_TIMEOUT_MS=6000

# ---- Invocation and dependency budgets (milliseconds) ----
# FUNCTION_MAX_DURATION_MS must mirror functions.app.ts.maxDuration in
# vercel.json. Every deadline is clamped to the remaining invocation budget.
FUNCTION_MAX_DURATION_MS=10000
RESPONSE_RESERVE_MS=500
# Reserved for an external caller/proxy. Unified SSR has no internal HTTP hop.
UPSTREAM_RESERVE_MS=1500
# Unset inherits the caller-safe request deadline.
#REQUEST_TIMEOUT_MS=
DB_TIMEOUT_MS=5000
DB_BATCH_TIMEOUT_MS=9000
DB_BOOTSTRAP_TIMEOUT_MS=8000
HEALTH_DB_TIMEOUT_MS=1500
SESSION_TIMEOUT_MS=3000
SSE_MAX_MS=7000

# ---- Database outage circuit breaker ----
DB_BREAKER_THRESHOLD=3
DB_BREAKER_COOLDOWN_MS=2000
DB_BREAKER_MAX_COOLDOWN_MS=10000
